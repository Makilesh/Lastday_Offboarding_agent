# Copy to .env and fill in. .env is gitignored; never commit real values.

# Fine-grained token of an owner of GITHUB_ORG.
# Repository access: only the repos tagged lastday-demo.
# Repository permissions: Administration, Contents, Pull requests, Workflows (read/write); Metadata (read).
# Organization permissions: Members (read/write).
GITHUB_TOKEN=

# The organization Last Day works in.
GITHUB_ORG=VoidAlgo

# Classic token (admin:org) of the demo member. Only used by
# `scripts/setup_demo.py --reset` to accept the org re-invite.
FATBATMAN_TOKEN=

# Shared secret TrueForge sends as "Authorization: Bearer <value>" to the Last Day MCP server.
# Any long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
LASTDAY_MCP_TOKEN=
